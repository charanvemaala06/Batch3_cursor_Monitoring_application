# Copy to .env and fill in real values. Never commit .env.
# Generate a strong SECRET_KEY, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Login username (no default; must be set explicitly)
ADMIN_USERNAME=

# Generate with:
#   python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
ADMIN_PASSWORD_HASH=

# Local HTTP demo: leave false. Set true only behind HTTPS.
SESSION_COOKIE_SECURE=false

# Optional override for encrypted server inventory path
# SERVERS_FILE=app/servers.json

# Local listen port (default 5000). Change if the port is already taken.
# PORT=5000

